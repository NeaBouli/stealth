<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Card styles -->
    <style name="Widget.SecureCall.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- FAB styles -->
    <style name="Widget.SecureCall.FAB.Call" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="backgroundTint">@color/call_active_green</item>
    </style>
    <style name="Widget.SecureCall.FAB.EndCall" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/call_end_red</item>
    </style>

    <!-- TopAppBar -->
    <style name="Widget.SecureCall.TopAppBar" parent="">
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

    <!-- BottomNav -->
    <style name="Widget.SecureCall.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>

    <!-- Circle shape for avatars -->
    <style name="ShapeAppearance.SecureCall.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Dialer button -->
    <style name="Widget.SecureCall.DialButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/stealthx_red</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:gravity">center</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:padding">4dp</item>
    </style>
</resources>
