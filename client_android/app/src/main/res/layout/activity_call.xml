<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stealthx_black">

    <!-- Connection state bar -->
    <TextView
        android:id="@+id/connectionState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_xl"
        android:text="@string/call_connecting"
        android:textColor="@color/stealthx_blue"
        android:textSize="@dimen/text_label_small"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Avatar circle -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/avatarImage"
        android:layout_width="@dimen/avatar_size_large"
        android:layout_height="@dimen/avatar_size_large"
        android:src="@drawable/ic_contacts"
        android:padding="24dp"
        android:background="@color/stealthx_gray"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.SecureCall.Circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.25"
        android:contentDescription="@string/cd_caller_avatar" />

    <!-- Caller name -->
    <TextView
        android:id="@+id/callerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/call_unknown_caller"
        android:textSize="@dimen/text_headline_medium"
        android:textColor="@color/stealthx_white"
        app:layout_constraintTop_toBottomOf="@id/avatarImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_lg" />

    <!-- Call timer -->
    <Chronometer
        android:id="@+id/callTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_title_medium"
        android:textColor="@color/stealthx_light_gray"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/callerName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_sm" />

    <!-- Encryption indicator -->
    <LinearLayout
        android:id="@+id/encryptionIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/callTimer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_md">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="@string/cd_encrypted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/call_encrypted"
            android:textColor="@color/encryption_verified"
            android:textSize="@dimen/text_label_small"
            android:layout_marginStart="@dimen/spacing_xs" />
    </LinearLayout>

    <!-- Security Status Indicator -->
    <LinearLayout
        android:id="@+id/securityStatusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_xs"
        app:layout_constraintTop_toBottomOf="@id/encryptionIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_sm">

        <ImageView
            android:id="@+id/securityStatusIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_shield"
            android:contentDescription="@string/cd_security_status" />

        <TextView
            android:id="@+id/securityStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/security_status_secure"
            android:textColor="@color/call_active_green"
            android:textSize="11sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Bottom action buttons -->
    <LinearLayout
        android:id="@+id/callActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="@dimen/spacing_lg"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/spacing_xl">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/call_fab_margin"
            android:src="@drawable/ic_mic"
            app:backgroundTint="@color/stealthx_gray"
            android:contentDescription="@string/cd_mute"
            app:fabSize="normal"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabEndCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_call_end"
            style="@style/Widget.SecureCall.FAB.EndCall"
            android:contentDescription="@string/cd_end_call"
            app:fabSize="auto"
            app:fabCustomSize="72dp"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSpeaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/call_fab_margin"
            android:src="@drawable/ic_speaker"
            app:backgroundTint="@color/stealthx_gray"
            android:contentDescription="@string/cd_speaker"
            app:fabSize="normal"
            app:tint="@android:color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
