<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Success Icon -->
        <TextView
            android:id="@+id/tvSuccessIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅"
            android:textSize="64sp"
            android:layout_marginTop="48dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Purchase Successful!"
            android:textColor="#00FFAA"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Activation Code:"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:layout_marginTop="32dp" />

        <!-- Code Display Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#222244"
            android:padding="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvActivationCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREM-XXXXXXXX"
                android:textColor="#00E676"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnCopyCode"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="📋 Copy Code"
                android:textColor="#000000"
                android:backgroundTint="#00E676" />

            <Button
                android:id="@+id/btnShareCode"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="📤 Share Code"
                android:textColor="#000000"
                android:backgroundTint="#FFD700" />
        </LinearLayout>

        <!-- Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter this code in\nSettings → Activation Code\nto activate Premium."
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            android:textAlignment="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Or gift it to anyone!"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textAlignment="center"
            android:textStyle="italic"
            android:layout_marginTop="8dp" />

        <!-- Activate Now Button -->
        <Button
            android:id="@+id/btnActivateNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="Activate Now"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#FF4444" />

        <!-- Status text for backend communication -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textAlignment="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
