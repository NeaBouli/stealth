<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upgrade SecureCall"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unlock advanced security and unlimited calls"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="24dp" />

        <!-- Current Tier -->
        <TextView
            android:id="@+id/tvCurrentTier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Plan: Free"
            android:textSize="16sp"
            android:textColor="#00FFAA"
            android:gravity="center"
            android:padding="12dp"
            android:background="#222244"
            android:layout_marginBottom="24dp" />

        <!-- LIMITED TIME OFFER Banner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIMITED TIME: Forever Licenses"
            android:textSize="18sp"
            android:textColor="#FF4444"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:background="#2A1010"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="One-time purchase. No subscription. Price increases with each sale!"
            android:textSize="12sp"
            android:textColor="#FFAAAA"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- PRO LIFETIME Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRO LIFETIME"
            android:textSize="20sp"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unlimited calls &amp; contacts\nCertificate pinning\nDevice attestation\nMulti-device support\nNo telemetry"
            android:textSize="13sp"
            android:textColor="#CCCCCC"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="8dp" />

        <!-- PRO Lifetime Price Info -->
        <TextView
            android:id="@+id/tvProLicensesLeft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only 100 licenses left!"
            android:textSize="14sp"
            android:textColor="#FFC107"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <ProgressBar
            android:id="@+id/progressProSold"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FFD700"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnProLifetime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buy PRO Lifetime — $15.00"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvProNextPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Next buyer pays: $15.35"
            android:textSize="11sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Subscription Alternative -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Or subscribe:"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnProMonthly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pro Monthly — $9.99/mo"
            android:backgroundTint="#333355"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnProYearly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pro Yearly — $99.99/yr (save 17%)"
            android:backgroundTint="#333355"
            android:layout_marginBottom="24dp" />

        <!-- PREMIUM LIFETIME Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PREMIUM LIFETIME"
            android:textSize="20sp"
            android:textColor="#FF4444"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All PRO features plus:\nHardware keystore required\nScreen capture detection\nDebugger detection\nEmulator blocking\nAggressive key rotation\nZero-fallback mode"
            android:textSize="13sp"
            android:textColor="#CCCCCC"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="8dp" />

        <!-- PREMIUM Lifetime Price Info -->
        <TextView
            android:id="@+id/tvPremiumLicensesLeft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only 100 licenses left!"
            android:textSize="14sp"
            android:textColor="#FF6666"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <ProgressBar
            android:id="@+id/progressPremiumSold"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FF4444"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPremiumLifetime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buy PREMIUM Lifetime — $25.00"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvPremiumNextPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Next buyer pays: $25.75"
            android:textSize="11sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Subscription Alternative -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Or subscribe:"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnPremiumMonthly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Premium Monthly — $29.99/mo"
            android:backgroundTint="#333355"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnPremiumYearly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Premium Yearly — $299.99/yr (save 17%)"
            android:backgroundTint="#333355"
            android:layout_marginBottom="24dp" />

        <!-- Restore -->
        <Button
            android:id="@+id/btnRestore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restore Purchase"
            android:backgroundTint="#444466"
            android:layout_marginBottom="16dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
