<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_choose_edition"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <!-- Current Tier -->
        <TextView
            android:id="@+id/tvCurrentTier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#00FFAA"
            android:gravity="center"
            android:padding="10dp"
            android:background="#222244"
            android:layout_marginBottom="16dp" />

        <!-- Edition cards -->

        <!-- FREE Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#222244"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_free_title"
                android:textSize="16sp"
                android:textColor="#AAAAAA"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_free_price"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_free_features"
                android:textSize="13sp"
                android:textColor="#999999"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/billingPurchaseContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_price_terms"
            android:textSize="13sp"
            android:textColor="#CCCCCC"
            android:layout_marginBottom="12dp" />

        <!-- PRO Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2A4A"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_pro_title"
                android:textSize="16sp"
                android:textColor="#FFD700"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_pro_price"
                android:textSize="16sp"
                android:textColor="#FFD700"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_pro_features"
                android:textSize="13sp"
                android:textColor="#CCCCCC"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnProLifetime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/upgrade_pro_lifetime"
                android:textSize="14sp"
                android:backgroundTint="#FFD700"
                android:textColor="#000000"
                android:enabled="false"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- PREMIUM Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2A1A1A"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_premium_title"
                android:textSize="16sp"
                android:textColor="#FF4444"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_premium_price"
                android:textSize="16sp"
                android:textColor="#FF4444"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_premium_features"
                android:textSize="13sp"
                android:textColor="#CCCCCC"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnPremiumLifetime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/upgrade_premium_lifetime"
                android:textSize="14sp"
                android:backgroundTint="#FF4444"
                android:textColor="#FFFFFF"
                android:enabled="false"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Activation Code -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2A1A"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_activation_code_title"
                android:textSize="14sp"
                android:textColor="#00E676"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_activation_code_description"
                android:textSize="13sp"
                android:textColor="#CCCCCC"
                android:lineSpacingMultiplier="1.4" />

            <Button
                android:id="@+id/btnActivationCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/upgrade_activation_code"
                android:textSize="14sp"
                android:backgroundTint="#00E676"
                android:textColor="#000000"
                android:enabled="false"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Restore + Status -->
        <Button
            android:id="@+id/btnRestore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/upgrade_restore_purchase"
            android:textSize="12sp"
            android:backgroundTint="#333355"
            android:layout_marginBottom="8dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
