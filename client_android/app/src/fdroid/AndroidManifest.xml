<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- F-Droid: no billing, no AdMob, no Firebase, no ad tracking -->

    <!-- Remove AD_ID permission (declared in main manifest for AdMob) -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <application>
        <!-- Remove FCM service since Firebase is not available -->
        <service
            android:name="com.securecall.app.fcm.SecureCallMessagingService"
            tools:node="remove" />

        <!-- Remove AdMob metadata (declared in free manifest) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            tools:node="remove" />
    </application>
</manifest>
