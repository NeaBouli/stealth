# ─── SecureCall Deployment Environment ─────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Domain Configuration ─────────────────────────────────
SIGNAL_DOMAIN=signal.stealthx.tech
TURN_HOST=turn.stealthx.tech
WEBSITE_DOMAIN=stealthx.tech
ADMIN_EMAIL=admin@stealthx.tech

# ─── Signaling Server ─────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_64CHARS
ALLOWED_ORIGINS=https://stealthx.tech,https://www.stealthx.tech
ALLOWED_SIGNATURES=
MAX_CONNS_PER_IP=10

# ─── STUN/TURN (own coturn — use-auth-secret mode) ────────
# Docker Compose reads the shared secret from deploy/secrets/turn_secret,
# not from this environment file. Create it before running Compose:
#   mkdir -p secrets
#   (umask 077 && openssl rand -hex 32 > secrets/turn_secret)
# For non-Compose deployments, configure exactly one of TURN_SECRET or
# TURN_SECRET_FILE in the runtime's private secret store.
STUN_URL=stun:stun.l.google.com:19302

# ─── STUN/TURN fallback (Metered.ca — only if coturn unavailable) ────
# Leave blank when using own coturn (the shared secret takes priority)
TURN_USER=
TURN_PASS=

# ─── Firebase Cloud Messaging (optional) ──────────────────
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Let's Encrypt ────────────────────────────────────────
CERTBOT_EMAIL=admin@stealthx.tech
CUSTOM_ID_STRIPE_CHECKOUT_ENABLED=false
GOOGLE_PLAY_ALLOWED_PACKAGES=com.securecall.app.free
GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# Private signed accounting handoff (must match VLABS FINANCE_INGEST_SECURECALL_SECRET)
VLABS_FINANCE_INGEST_URL=
VLABS_FINANCE_INGEST_SECRET=
