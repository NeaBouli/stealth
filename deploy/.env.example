# ─── SecureCall Deployment Environment ─────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Domain Configuration ─────────────────────────────────
DOMAIN=securecall.app
SIGNAL_DOMAIN=signal.securecall.app
TURN_DOMAIN=turn.securecall.app
WEBSITE_DOMAIN=stealthx.app
ADMIN_EMAIL=admin@stealthx.app

# ─── Signaling Server ─────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
ALLOWED_ORIGINS=https://signal.securecall.app,https://stealthx.app
MAX_CONNS_PER_IP=10

# ─── STUN/TURN ────────────────────────────────────────────
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:turn.securecall.app:3478
TURN_USER=securecall
TURN_PASS=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
TURN_REALM=securecall.app

# ─── Firebase Cloud Messaging (optional) ──────────────────
# Path to Firebase service account JSON (inside container)
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── Let's Encrypt ────────────────────────────────────────
CERTBOT_EMAIL=admin@stealthx.app
